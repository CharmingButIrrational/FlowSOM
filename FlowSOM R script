#Generate random coordinates
MSTFunt <- function(x, output){
  count = x[2]
  rRad = MST_nodesize * sqrt(x[2]) 
  xCord = x[3]
  yCord = x[4]
  runifdisc(count, radius = rRad, centre=c(xCord, yCord), drop = FALSE)
}

tSNEFunt <- function(x, output){
  count = x[2]
  rRad = tSNE_nodesize * sqrt(x[2]) 
  xCord = x[3]
  yCord = x[4]
  runifdisc(count, radius = rRad, centre=c(xCord, yCord), drop = FALSE)
}

GridFunt <- function(x, output){
  count = x[2]
  rRad = Grid_nodesize * sqrt(x[2]) 
  xCord = x[3]
  yCord = x[4]
  runifdisc(count, radius = rRad, centre=c(xCord, yCord), drop = FALSE)
}

