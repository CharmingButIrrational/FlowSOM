  #Calculating the amount of rows and coloumns of the data matrix
  input_temp_row_numbers <- nrow(input_temp)
  input_temp_col_numbers <- ncol(input_temp)
  
  #Defining identyfier for each sample
  a <- i * 50000
  sample <- rep(a, length.out = input_temp_row_numbers)
  
  #Adding a coloumn for sample identifier to data input
  input_temp <- cbind(input_temp, sample)
  
  # merge control and input, check for identity
  inputnames <- names(input_temp)
  names_control <- cbind(names_control, inputnames)
  names(input_temp) <- names(compound_control) # input1 column names are retained
  
  #Adding data of current iteration to data of previous iteration(s)
  compound_control <- rbind(compound_control, input_temp)
}

